# --- Secrets / environment ---
# Real .env files hold DB_PASSWORD, JWT_SECRET_KEY, SMTP credentials, etc.
# Only the .example templates should ever be committed.
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# --- Python / backend ---
backend/venv/
backend/venv312/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime logs - regenerated locally, not part of the source.
backend/logs/
*.log

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
