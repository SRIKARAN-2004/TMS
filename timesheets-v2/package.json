{
  "name": "timesheets-v2-dev",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && venv/Scripts/uvicorn app.main:app --reload --port 8001",
    "dev:backend:unix": "cd backend && venv/bin/uvicorn app.main:app --reload --port 8001",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
