# Set to "production" when deploying. Controls fail-closed defaults below -
# leave unset ("development") for local work.
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# No default - the app refuses to start without this set (see core/config.py).
DB_PASSWORD=srikaran
DB_NAME=timesheets_v2

# No default - the app refuses to start without this set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# How long a login session lasts. The access token (attached to every
# request) is short by design; the refresh token is what actually keeps
# someone logged in - the frontend silently trades it for a new access
# token whenever the current one expires (see /auth/refresh), for up to
# REFRESH_TOKEN_EXPIRE_DAYS since their last activity.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1

FRONTEND_ORIGIN=http://localhost:5173

# Defaults to true (cookies require HTTPS) - set to false only for local
# dev over plain http.
COOKIE_SECURE=false

# --- Outbound email (SMTP) ---
# Used for the "forgot password" reset-link email and the welcome email
# sent to a new user's company mail with their login credentials. Leave
# unset for local dev - the backend logs the message instead of sending
# it (see app/core/mailer.py), so nothing breaks without a real mail
# server configured. Example values for Gmail (use an app password, not
# your normal password) or any other SMTP provider:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if unset.
SMTP_FROM=
SMTP_FROM_NAME=Timesheets
SMTP_USE_TLS=true

# Minutes a "forgot password" link stays valid for.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
