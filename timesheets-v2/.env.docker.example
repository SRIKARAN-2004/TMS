# Copy this file to ".env" (same folder as docker-compose.yml) and fill
# in real values before running `docker compose up`. docker-compose reads
# a file literally named ".env" in this directory automatically - it
# doesn't need to be passed in with --env-file unless you rename it.

# MySQL root password - also used as the backend's DB_PASSWORD since the
# backend connects as root inside the docker network. Pick something
# real, this is not for production reuse anywhere else.
DB_PASSWORD=change_me_to_a_real_password
DB_NAME=timesheets_v2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# The origin the browser will actually load the frontend from - must
# match exactly (scheme + host + port) for CORS/cookies to work.
FRONTEND_ORIGIN=http://localhost

# The URL the browser will use to reach the backend API - gets baked
# into the frontend's JS bundle at build time (see frontend/Dockerfile).
VITE_API_BASE_URL=http://localhost:8000

# Set to "false" only for local/plain-http testing. Set to "true" (or
# just omit this line, since "true" is the default) once you're serving
# everything over HTTPS.
COOKIE_SECURE=false

ENVIRONMENT=production

# --- Optional: outbound email (forgot-password / welcome emails) ---
# Leave blank to skip - the backend just logs the message instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Timesheets
